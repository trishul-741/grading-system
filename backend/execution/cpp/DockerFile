FROM debian:bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       g++ \
       python3 \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd --gid 10001 runner \
    && useradd --uid 10001 --gid 10001 --no-create-home \
       --shell /usr/sbin/nologin runner \
    && install -d -o 10001 -g 10001 -m 0700 /workspace

# The supervisor is image-owned on the read-only root filesystem. It must be
# PID1: do not insert a shell, Docker --init, or a different entrypoint.
COPY --chown=0:0 phase_runner.py /opt/execution/phase_runner.py
RUN chmod 0555 /opt/execution/phase_runner.py

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 LANG=C.UTF-8
WORKDIR /workspace
USER 10001:10001
ENTRYPOINT ["/usr/bin/python3", "-I", "/opt/execution/phase_runner.py"]
