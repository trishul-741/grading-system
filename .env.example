# Copy these settings into your ignored .env; choose a fresh password.
POSTGRES_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD
# URL-encode the password in this URL. It must match POSTGRES_PASSWORD.
DATABASE_URL=postgresql+psycopg2://grader:REPLACE_WITH_URL_ENCODED_PASSWORD@127.0.0.1:5432/grading_db

# Required for login and protected APIs. Generate a fresh random secret in .env.
# Empty or invalid secrets fail closed; no development fallback is provided.
AUTH_SECRET_KEY=
AUTH_ISSUER=grading-system
AUTH_AUDIENCE=grading-api
AUTH_ACCESS_TOKEN_MINUTES=15

EXECUTION_SOURCE_LIMIT_BYTES=65536
EXECUTION_INPUT_LIMIT_BYTES=65536
EXECUTION_STDOUT_LIMIT_BYTES=65536
EXECUTION_STDERR_LIMIT_BYTES=65536
EXECUTION_COMPILE_TIMEOUT_SECONDS=15
EXECUTION_RUNTIME_TIMEOUT_SECONDS=3
EXECUTION_COMPILE_MEMORY_MB=512
EXECUTION_RUNTIME_MEMORY_MB=256
EXECUTION_CPUS=1
EXECUTION_PIDS_LIMIT=32
EXECUTION_MAX_CONCURRENT_JOBS=2

# New grading routes are disabled until deliberately enabled for local use.
OBJECTIVE_GRADING_API_ENABLED=false
OBJECTIVE_GRADING_ENVIRONMENT=development
# Deprecated and ignored: application routes require a real user JWT instead.
OBJECTIVE_GRADING_API_TOKEN=
OBJECTIVE_GRADING_MAX_TESTS=100
OBJECTIVE_GRADING_MAX_SNAPSHOT_BYTES=8388608
OBJECTIVE_GRADING_EVIDENCE_LIMIT_BYTES=65536
OBJECTIVE_GRADING_WORKER_POLL_SECONDS=2
